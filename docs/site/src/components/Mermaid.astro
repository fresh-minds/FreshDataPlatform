---
interface Props {
  chart: string;
  id?: string;
}

const { chart, id = `mermaid-${Math.random().toString(36).slice(2, 8)}` } = Astro.props;
---

<div class="mermaid-container my-6">
  <div id={id} class="mermaid-target"></div>
  <pre id={`${id}-src`} class="mermaid-source hidden">{chart}</pre>
</div>

<script>
  async function initMermaid() {
    const { default: mermaid } = await import('mermaid');
    mermaid.initialize({
      startOnLoad: false,
      theme: 'default',
      securityLevel: 'loose',
      flowchart: {
        useMaxWidth: true,
        htmlLabels: true,
        curve: 'basis',
      },
    });

    const sources = document.querySelectorAll<HTMLPreElement>('pre.mermaid-source');
    for (const src of sources) {
      const targetId = src.id.replace('-src', '');
      const target = document.getElementById(targetId);
      if (!target) continue;
      const chart = src.textContent?.trim();
      if (!chart) continue;
      try {
        const { svg } = await mermaid.render(targetId + '-svg', chart);
        target.innerHTML = svg;
      } catch (e) {
        console.warn('Mermaid render error:', e);
        target.innerHTML = `<pre class="text-sm text-red-500 p-4 bg-red-50 rounded">${chart}</pre>`;
      }
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMermaid);
  } else {
    initMermaid();
  }
</script>
