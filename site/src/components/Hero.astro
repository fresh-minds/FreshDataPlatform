---
const base = import.meta.env.BASE_URL;
---

<section class="relative bg-gradient-to-br from-[#0a1628] via-navy to-[#0d2847] text-white overflow-hidden">
  <div class="absolute inset-0 opacity-10">
    <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-cyan rounded-full filter blur-[128px]"></div>
    <div class="absolute bottom-1/4 right-1/4 w-64 h-64 bg-mint rounded-full filter blur-[96px]"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 md:py-28">
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold leading-tight mb-6">
          Open Data
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan to-mint">Platform</span>
        </h1>
        <p class="text-lg md:text-xl text-gray-300 mb-8 leading-relaxed max-w-lg">
          An open, developer-first data platform that combines orchestration, lakehouse processing, governance, BI, and observability in one stack.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href={`${base}docs/`} class="inline-flex items-center px-6 py-3 bg-cyan text-navy font-semibold rounded-lg hover:bg-cyan-dark transition-colors shadow-lg shadow-cyan/20">
            Explore Docs
            <svg class="w-4 h-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>
          <a href={`${base}docs/development/`} class="inline-flex items-center px-6 py-3 border border-gray-500 text-gray-300 font-semibold rounded-lg hover:border-cyan hover:text-cyan transition-colors">
            Quick Start
          </a>
        </div>
      </div>
      <div class="flex justify-center">
        <img src={`${base}images/odp_hero.png`} alt="Open Data Platform" class="w-full max-w-md rounded-xl shadow-2xl shadow-cyan/10" />
      </div>
    </div>
  </div>
</section>
