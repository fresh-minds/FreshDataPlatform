---
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const links = [
  { href: `${base}`, label: 'Home' },
  { href: `${base}docs/`, label: 'Docs' },
  { href: `${base}docs/architecture/`, label: 'Architecture' },
  { href: 'https://github.com/fresh-minds/FreshDataPlatform', label: 'GitHub', external: true },
];
---

<nav class="bg-navy text-white sticky top-0 z-50 shadow-lg">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <a href={base} class="flex items-center gap-2 font-heading font-bold text-lg hover:text-cyan transition-colors">
        <svg class="w-8 h-8" viewBox="0 0 32 32" fill="none">
          <rect x="2" y="2" width="28" height="28" rx="6" fill="#00D4FF" opacity="0.2" stroke="#00D4FF" stroke-width="1.5"/>
          <path d="M8 22L16 10L24 22" stroke="#00D4FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M12 18H20" stroke="#4ADE80" stroke-width="2" stroke-linecap="round"/>
        </svg>
        Open Data Platform
      </a>

      <!-- Desktop nav -->
      <div class="hidden md:flex items-center gap-6">
        {links.map(link => (
          <a
            href={link.href}
            class:list={[
              'text-sm font-medium transition-colors hover:text-cyan',
              currentPath === link.href ? 'text-cyan' : 'text-gray-300',
            ]}
            {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            {link.label}
            {link.external && (
              <svg class="inline-block w-3 h-3 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            )}
          </a>
        ))}
      </div>

      <!-- Mobile hamburger -->
      <button id="mobile-menu-btn" class="md:hidden p-2 rounded-lg hover:bg-navy-light transition-colors" aria-label="Toggle menu">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-navy-light">
    <div class="px-4 py-3 space-y-2">
      {links.map(link => (
        <a
          href={link.href}
          class="block py-2 text-sm text-gray-300 hover:text-cyan transition-colors"
          {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
</nav>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
</script>
