---
const base = import.meta.env.BASE_URL;

const technologies = [
  { name: 'Apache Airflow', logo: 'airflow.svg', url: 'https://airflow.apache.org/' },
  { name: 'MinIO', logo: 'minio.svg', url: 'https://min.io/' },
  { name: 'dbt', logo: 'dbt.svg', url: 'https://www.getdbt.com/' },
  { name: 'Apache Superset', logo: 'superset.svg', url: 'https://superset.apache.org/' },
  { name: 'Keycloak', logo: 'keycloak.svg', url: 'https://www.keycloak.org/' },
  { name: 'DataHub', logo: 'datahub.svg', url: 'https://datahubproject.io/' },
  { name: 'Grafana', logo: 'grafana.svg', url: 'https://grafana.com/' },
  { name: 'Prometheus', logo: 'prometheus.svg', url: 'https://prometheus.io/' },
  { name: 'PostgreSQL', logo: 'postgres.svg', url: 'https://www.postgresql.org/' },
  { name: 'Docker', logo: 'docker.svg', url: 'https://www.docker.com/' },
  { name: 'Kubernetes', logo: 'kubernetes.svg', url: 'https://kubernetes.io/' },
  { name: 'Terraform', logo: 'terraform.svg', url: 'https://www.terraform.io/' },
];
---

<section class="py-20 bg-surface">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl font-extrabold text-navy text-center mb-4">Technology Stack</h2>
    <p class="text-center text-gray-600 mb-12 max-w-2xl mx-auto">
      Built on battle-tested open source technologies.
    </p>
    <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 gap-6">
      {technologies.map(tech => (
        <a
          href={tech.url}
          target="_blank"
          rel="noopener noreferrer"
          class="flex flex-col items-center gap-3 p-4 bg-white rounded-xl border border-gray-100 hover:border-cyan hover:shadow-md transition-all group"
        >
          <img
            src={`${base}images/tech-logos/${tech.logo}`}
            alt={tech.name}
            class="w-10 h-10 object-contain"
            loading="lazy"
          />
          <span class="text-xs font-medium text-gray-600 group-hover:text-navy text-center">{tech.name}</span>
        </a>
      ))}
    </div>
  </div>
</section>
