---
const props = [
  {
    title: 'Medallion Architecture',
    description: 'Ingest and transform data through Bronze, Silver, and Gold layers with both Spark-compatible and Postgres/dbt transformation paths.',
    icon: `<svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/></svg>`,
    color: 'cyan',
  },
  {
    title: 'Full Observability',
    description: 'Integrated Prometheus metrics, Grafana dashboards, Loki logs, and Tempo traces with OpenTelemetry instrumentation.',
    icon: `<svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5"/></svg>`,
    color: 'mint',
  },
  {
    title: 'Deploy Anywhere',
    description: 'Run locally with Docker Compose, scale with Kubernetes (kind), or deploy to Azure AKS and Scaleway with Terraform.',
    icon: `<svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.25 15a4.5 4.5 0 004.5 4.5H18a3.75 3.75 0 001.332-7.257 3 3 0 00-3.758-3.848 5.25 5.25 0 00-10.233 2.33A4.502 4.502 0 002.25 15z"/></svg>`,
    color: 'amber',
  },
];
---

<section class="py-20 bg-surface">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl font-extrabold text-navy text-center mb-12">Core Capabilities</h2>
    <div class="grid md:grid-cols-3 gap-8">
      {props.map(prop => (
        <div class="bg-white rounded-xl p-8 shadow-sm border border-gray-100 hover:shadow-md hover:border-gray-200 transition-all">
          <div class={`inline-flex items-center justify-center w-14 h-14 rounded-lg mb-5 ${
            prop.color === 'cyan' ? 'bg-cyan/10 text-cyan-dark' :
            prop.color === 'mint' ? 'bg-mint/10 text-green-600' :
            'bg-amber/10 text-amber-600'
          }`}>
            <Fragment set:html={prop.icon} />
          </div>
          <h3 class="text-xl font-bold text-navy mb-3">{prop.title}</h3>
          <p class="text-gray-600 leading-relaxed">{prop.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
