---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DocCards from '../../components/DocCards.astro';
---

<BaseLayout title="Documentation | Open Data Platform">
  <div class="bg-navy text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-extrabold mb-4">Documentation</h1>
      <p class="text-lg text-gray-300 max-w-2xl">
        Guides and references for understanding, deploying, and extending the Open Data Platform.
      </p>
    </div>
  </div>
  <DocCards />
</BaseLayout>
