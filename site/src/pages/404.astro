---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Page Not Found | Open Data Platform">
  <div class="min-h-[60vh] flex items-center justify-center">
    <div class="text-center">
      <h1 class="text-6xl font-extrabold text-navy mb-4">404</h1>
      <p class="text-xl text-gray-600 mb-8">Page not found.</p>
      <a href={base} class="inline-flex items-center px-6 py-3 bg-cyan text-navy font-semibold rounded-lg hover:bg-cyan-dark transition-colors">
        Back to Home
      </a>
    </div>
  </div>
</BaseLayout>
